------MultipartBoundary--nz2gKDwSIA2Drc7qvEB0zbe9xgXLJpjr79jfmiSkm1----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-b7a56341-35cb-4e9e-8c3a-51ff4116f4bb@mhtml.blink

@charset "utf-8";

:root { --bg: #f5f8ff; --card: #fff; --bd: #e1e8f5; --v: #2563eb; --v2: #3b82f6; --gold: #93c5fd; --tx: #0f172a; --mu: #666b85; --g: linear-gradient(135deg,#3b82f6,#1d4ed8); }

* { box-sizing: border-box; margin: 0px; padding: 0px; -webkit-tap-highlight-color: transparent; }

html { scroll-behavior: smooth; scrollbar-width: thin; scrollbar-color: rgb(37, 99, 235) rgb(240, 245, 255); }

::-webkit-scrollbar { width: 6px; height: 6px; }

::-webkit-scrollbar-track { background: rgb(240, 245, 255); }

::-webkit-scrollbar-thumb { background: linear-gradient(rgb(59, 130, 246), rgb(29, 78, 216)); border-radius: 99px; }

::-webkit-scrollbar-thumb:hover { background: rgb(29, 78, 216); }

body { font-family: Inter, "Noto Sans Bengali", Roboto, system-ui, sans-serif; background: var(--bg); color: var(--tx); min-height: 100vh; -webkit-font-smoothing: antialiased; text-rendering: optimizelegibility; overflow-x: hidden; }

body::before { content: ""; position: fixed; inset: 0px; z-index: -1; pointer-events: none; background-image: radial-gradient(600px 400px at 90% -5%, rgba(37, 99, 235, 0.12), transparent 70%), radial-gradient(500px 500px at -10% 45%, rgba(96, 165, 250, 0.14), transparent 70%); transform: translateZ(0px); will-change: transform; }

a { color: inherit; text-decoration: none; }

svg.i { width: 1em; height: 1em; fill: none; stroke: currentcolor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

svg.f { width: 1em; height: 1em; fill: currentcolor; stroke: none; }

.wrap { max-width: 1000px; margin: 0px auto; padding: 0px 16px; }

.ph { position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; color: rgb(37, 99, 235); text-align: center; background: linear-gradient(110deg, rgb(230, 238, 255) 30%, rgb(244, 248, 255) 50%, rgb(230, 238, 255) 70%) 0px 0px / 200% 100%; animation: 2.4s linear 0s infinite normal none running sh; }

.thumb.ph { animation: auto ease 0s 1 normal none running none; background: rgb(232, 240, 254); }

.ph picture { position: absolute; inset: 0px; width: 100%; height: 100%; display: block; }

.ph img { position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; object-position: center center; display: block; }

@keyframes sh { 
  100% { background-position: -200% 0px; }
}

header { position: sticky; top: 0px; z-index: 40; background: rgb(255, 255, 255); border-bottom: 1px solid var(--bd); padding-top: env(safe-area-inset-top); }

.hd { display: flex; align-items: center; justify-content: space-between; height: 68px; }

.logo { display: inline-flex; align-items: center; height: 44px; max-width: 145px; }

.logo img { height: 100%; width: auto; max-width: 100%; object-fit: contain; display: block; }

.hr { display: flex; align-items: center; gap: 12px; }

.wallet { display: flex; align-items: center; gap: 8px; height: 42px; padding: 0px 16px 0px 12px; border-radius: 99px; background: var(--g); color: rgb(255, 255, 255); font-weight: 700; font-size: 15px; box-shadow: rgba(37, 99, 235, 0.6) 0px 8px 18px -6px; }

.wallet svg { font-size: 19px; }

.avatar { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 50%; padding: 2px; background: linear-gradient(135deg, rgb(59, 130, 246), rgb(29, 78, 216)); box-shadow: rgba(37, 99, 235, 0.5) 0px 6px 14px -4px; cursor: pointer; transition: 0.2s; }

.avatar:hover { transform: scale(1.05); }

.avatar:active { transform: scale(0.95); }

.avatar .av-inner { width: 100%; height: 100%; border-radius: 50%; background: rgb(239, 246, 255); display: flex; align-items: center; justify-content: center; color: rgb(37, 99, 235); }

.avatar .av-inner svg { width: 21px; height: 21px; stroke-width: 2.2; }

.hero { margin-top: 18px; position: relative; border-radius: 26px; overflow: hidden; border: 1.5px solid rgb(30, 41, 59); box-shadow: rgb(30, 41, 59) 0px 4px 0px, rgba(17, 24, 39, 0.28) 0px 16px 36px -12px; user-select: none; touch-action: pan-y; background: rgb(5, 13, 36); cursor: grab; transform: translateZ(0px); }

.hero:active { cursor: grabbing; }

.track { display: flex; width: 100%; will-change: transform; backface-visibility: hidden; transform: translateZ(0px); }

.slide { flex: 0 0 100%; width: 100%; min-width: 100%; position: relative; aspect-ratio: 2 / 1; min-height: 160px; border-radius: 0px; font-size: 15px; overflow: hidden; background: rgb(5, 13, 36); backface-visibility: hidden; }

.slide img { pointer-events: none; -webkit-user-drag: none; user-select: none; width: 100%; height: 100%; object-fit: cover; object-position: center center; display: block; backface-visibility: hidden; }

.dots { position: absolute; left: 0px; right: 0px; bottom: 14px; display: flex; justify-content: center; gap: 7px; z-index: 10; pointer-events: none; }

.dots i { width: 16px; height: 5px; border-radius: 6px; background: rgba(255, 255, 255, 0.45); cursor: pointer; pointer-events: auto; transition: 0.4s cubic-bezier(0.2, 1, 0.3, 1); box-shadow: rgba(0, 0, 0, 0.45) 0px 1px 4px; }

